/* component/skeleton/skeleton.wxss */
.skeleton {
    padding: 10px;
    display: flex;
    align-items: center;
  }
.skeleton-user {
    width: 53px;
    height: 53px;
    margin-right: 10px;
    background-color: #e0e0e0;
    border-radius: 60px;
    margin-bottom: 10px;
    animation: shimmer 1.5s infinite linear; /* 添加动画 */
  }

.skeleton-header {
    width: 80px;
    height: 20px;
    background-color: #e0e0e0;
    border-radius: 4px;
    margin-bottom: 10px;
    animation: shimmer 1.5s infinite linear; /* 添加动画 */
  }
  
  .skeleton-title {
    width: 60%;
    height: 16px;
    background-color: #e0e0e0;
    border-radius: 4px;
    margin-bottom: 15px;
    animation: shimmer 1.5s infinite linear; /* 添加动画 */
  }
  
  .skeleton-content .skeleton-line {
    width: 100%;
    height: 12px;
    background-color: #e0e0e0;
    border-radius: 4px;
    margin-bottom: 8px;
    animation: shimmer 1.5s infinite linear; /* 添加动画 */
  }
  
  .skeleton-content .skeleton-line.long {
    width: 80%;
  }
  
  @keyframes shimmer {
    0% {
      background-color: #f2f2f2;
    }
    50% {
      background-color: #e0e0e0;
    }
    100% {
      background-color: #f2f2f2;
    }
  }


 