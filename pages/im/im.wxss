/* pages/im/im.wxss */
page{
    height: 100vh;
    background-color: #E7EBED;
}
.im{
    display: flex;
    height: 100vh;
    flex-direction: column;
    justify-content: space-between;
}
.ims{
    flex-grow: 1;
    min-height: 90vh;
}
.left{
    display: flex;
    margin-left: 15px;
    margin-bottom: 10px;
}
.left .userImg{
    width: 43px;
    height: 43px;
    border-radius:50px;
}
.left .row{
    display: flex;
    flex-direction: column;
}
.left .row .userName{
    margin-left: 12px;
    margin-bottom: 1px;
}
.msg{
    background-color: #fff;
    display: flex;
    flex-direction: column;
    margin:0 10px;
    padding: 5px 10px;
    border-radius: 5px;
}
.msg text{
    color: #646464;
}
.rigth{
    display: flex;
    justify-content: flex-end;
    margin-bottom: 10px;
}

.sends{
    width: 100vw;
    position: relative;
}
.actItem{
    height: 98px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    position: absolute;
        top: -100px;
}
.act{
    margin-left: 15px;
    display: flex;
    padding-right: 5px;
    justify-content: space-between;
}
.act text{
    font-size: 20px;
    margin-right: 10px;
}
.ciLi{
    width: 100vw;
    margin-bottom: 3px;
}
.ci{
    background-color: #fff;
    padding: 1px 3px;
    margin-left: 5px;
    font-size: 12px;
    border-radius:3px;    
    text-align: center;
    color: #687980;
}
.sendItem{
    display: flex;
    background-color: #fff;
    flex-direction: row;
    padding: 5px 10px 15px;
    justify-content: space-between;
    align-items: center;
}
.sendItem textarea{
    background-color: #E7EBED;
    flex: 1;
    padding: 3px 6px;
    border-radius: 3px;
    margin: 0 10px;
    color: #687980;
    font-size: 18px;
    letter-spacing: 1px;
}
.sendItem button{
    width: 40px;
    font-size: 13px;
    margin: 0;
    padding: 0 4px;
    letter-spacing: 2px;
    color: #fff;
    background-image: linear-gradient(to right, #66ECC3, #57D0D9);
}

.container{
}
.container button{
    color: #fff;
    font-size: 12px;
    margin-left: 10px;
    padding: 1px 5px;
    border-radius:3px;
    text-align: center;
    letter-spacing: 1px;
    background-color: #687980;
}
.container .row1{
    display: flex;
    align-items: center;
    padding: 5px 5px 15px;
    border-bottom:1px solid #D8D8D8 ;

}
.container .row1 input{
    flex: 1;
    background-color: #E7EBED;
    color: #687980;
    margin: 0 10px;
    padding: 5px 5px;
    font-size: 14px;
    letter-spacing: 2px;
    border-radius: 5px;
}
.container  .row2{
   
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 15px 5px;
    border-bottom:1px solid #D8D8D8 ;
} 
.container  .row2 .btnRow{
    display: flex;
}
.container  .row3 {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    padding-top: 10px;
    padding-bottom: 20px;
}
.container .row3  .user{
    width: 50px;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 5px 3px;
}
.container .row3 text{
    width: 50px;
    text-align: center;
}
.container .row3  .userImg{
    width: 50px;
    height: 50px;
    margin-bottom: 5px;
}

.into{
    height: 10px;
}