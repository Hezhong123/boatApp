/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #FFFFFF;
}
.top{
    margin-top: 48px;
    margin-left: 10px;
    margin-right: 100px;
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.userImg{
    width: 33px;
    height: 33px;
    border-radius: 33px;
}

.lis{
    display: flex;
    flex: 1;
    margin-left: 10px;
    padding: 20px 0;
    border-bottom:1px solid #E7EBED ;
}
.user{
    position: relative;
    width: 50px;
    height: 50px;
    margin-left: 5px;
}
.iconRed{
    background-color: #E02020;
    color: #FFFFFF;
    position: absolute;
        top: -5px;
        right: -5px;
    font-size: 10px;
    padding: 1px 2px;
    min-width: 15px;
    text-align: center;
    border-radius:10px;
}
.liImg{
    width: 100%;
    height: 100%;
    border-radius: 50px;
}
.line{
    background-color: #6DD400;
    width: 10px;
    height: 10px;
    border-radius: 10px;
    position: absolute;
        bottom: 3px;
        right: 3px;
}
.textRow{
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0 10px;
}
.row{
    display: flex;
    flex-direction: column;
}

.model{
    width: 100vw;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(2px);
    position: fixed;
        top: 0;
        left: 0;
    display: flex;
    z-index: 1;
    justify-content: center;
    align-items: center;    
}
.model .row{
    z-index: 2;
    width: 70vw;
    height: 200px;
    background-color: #FFFFFF;
    border-radius: 5px;
    padding: 10px;
    position: relative;
}
.model .row .textCol{
    display: flex;
    flex-direction: column;
    width: 80%;
    margin: 5% 6%;
    margin-bottom: 30px;
}
.model .row button{
    width: 90%;
    background-image: linear-gradient(to right, #66ECC3, #57D0D9);
    color: #FFFFFF;
    letter-spacing: 3px;
    font-size: 15px;
}

