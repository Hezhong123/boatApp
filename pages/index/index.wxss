/**index.wxss**/
page {
    height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: #FFFFFF;
}

.top {
    margin-left: 10px;
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.userImg {
    width: 33px;
    height: 33px;
    border-radius: 33px;
}

.lis {
    width: 100vw;
    display: inline-flex;
    flex-direction: row;
    white-space: nowrap;
    margin-left: 10px;
    padding: 10px 0;
    border-bottom: 1px solid #E7EBED;
    transition: transform 0.3s ease-out;
}

.user {
    width: 50px;
    height: 50px;
    margin-left: 5px;
    position: relative;
}

.iconRed {
    background-color: #E02020;
    color: #FFFFFF;
    position: absolute;
    top: -5px;
    right: -5px;
    font-size: 10px;
    padding: 1px 2px;
    min-width: 15px;
    text-align: center;
    border-radius: 10px;
}

.liImg {
    width: 100%;
    height: 100%;
    border-radius: 50px;
}

.line {
    background-color: #6DD400;
    width: 10px;
    height: 10px;
    border-radius: 10px;
    position: absolute;
    bottom: 3px;
    right: 3px;
}

.textRow {
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: center; 
    margin: 0 10px;
}

.textRow .row {
    display: flex;
    flex-direction: column;
    justify-content: center;
}
.textRow .row text{
}

.textRow .row .textLin {
    width: 60vw;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.model {
    width: 100vw;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(2px);
    position: fixed;
    top: 0;
    left: 0;
    display: flex;
    z-index: 1;
    justify-content: center;
    align-items: center;
}

.model .row {
    z-index: 2;
    width: 70vw;
    height: 200px;
    background-color: #FFFFFF;
    border-radius: 5px;
    padding: 10px;
    position: relative;
}

.model .row .textCol {
    display: flex;
    flex-direction: column;
    width: 80%;
    margin: 5% 6%;
    margin-bottom: 30px;
}

.model .row button {
    width: 90%;
    background-image: linear-gradient(to right, #66ECC3, #57D0D9);
    color: #FFFFFF;
    letter-spacing: 3px;
    font-size: 15px;
}


.Trow {
    width: 100%;
    overflow: hidden;
    white-space: nowrap;
    position: relative;
}


.Trow .rmIm {
    text-align: center;
    padding: 10px 15px;
    background-color: rgb(212, 41, 41);
    font-size: 13px;
    color: #FFFFFF;
    display: inline-block;
    list-style: 2px;
    position: relative;
        top: -20px;
}


.list {
    width: 100%;
    overflow-x: hidden;
    position: relative;
  }
  
  .list-item {
    position: absolute; /* 使删除按钮可以绝对定位 */
    display: flex;
    width: 100%;
    height: 70px;
    border-bottom: 1px solid #eee;
    transition: transform 0.3s ease-out; /* 添加过渡动画 */
    margin-left: 10px;
  }
  
  .item-content {
    flex-grow: 1;
    padding: 5px;
    background-color: #fff;
    display: flex;
    align-items: center;
    width: 100vw;
  }
  
  .delete-button {
    position: absolute;
    top: 0;
    right: -80px; /* 初始隐藏在右侧 */
    width: 70px;
    height: 70px;
    line-height: 70px;
    background-color: #ff3b30;
    color: #fff;
    text-align: center;
  }
  
  .list-item.slide-out .delete-button {
    transform: translateX(-80px); /* 滑动显示删除按钮 */
    transition: transform 0.3s ease-out;
  }