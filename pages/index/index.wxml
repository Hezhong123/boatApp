<!--index.wxml-->
<wxs src="../../utils/index.wxs" module="utils" />
<view>
    <view class="top">
        <text class="ico1" bind:tap="onMode">➕</text>
        <image class="userImg" bind:tap="navPage" data-page="me" src="{{user.avatarUrl}}" 
        mode="aspectFill" alt="" />
    </view>
    <scroll-view wx:if="{{ims.length}}" type="list" scroll-y>
        <view class="lis" wx:for="{{ims}}" wx:key="ims" bind:tap="navIms" 
        data-title="对话人"
        data-ims="{{item._id}}">
            <view class="user">
                <text class="iconRed" wx:if="{{utils.unread(user.id,item.unread)}}" > {{utils.unread(user.id,item.unread)}}</text>
                <image wx:if="{{true}}" class='liImg' src="{{utils.userTo(user.id,item.userArr).avatarUrl}}" mode="aspectFill" alt="" />
                <view wx:else>
                    <image class='liImg' src="{{userImg}}" mode="aspectFill" alt="" />
                </view>
                <view wx:if="{{utils.userTo(user.id,item.userArr).online}}" class="line"></view>
            </view>
            <view class="textRow">
                <view class="row">
                    <text class="t1 titleColor"> {{utils.userTo(user.id,item.userArr).nickname}} </text>
                    <text class="t3 textColor"> {{item.newMsg}} </text>
                </view>
                <text class="t5 timeColor"> {{utils.times(item.updatedAt)}} </text>
            </view>
        </view>
    </scroll-view>
    <view wx:else> 
        <text> 没有数据 </text>
    </view>

   <view show="true" class="model" wx:if="{{modelA}}" bind:tap="onMode" >
        <view class="row">
            <view class="textCol">
                <text class="t1 titleColor" style="margin-bottom: 10px;"> 学习的路上, \n <text class="t3">On the way to learning,</text> </text>
                
                <text class="t1 titleColor"> 与Ta同行 \n <text class="t3">Walk with Ta</text> </text>
            </view>
          
            <button catch:tap="childCatchTap"> 分享 </button>
        </view>
   </view>
</view>